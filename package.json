{
  "name": "hawkeye-cli",
  "version": "0.3.0",
  "description": "Hawkeye: reachability-aware dependency vulnerability analysis for npm, Python, Maven and Gradle projects.",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "hawkeye": "dist/cli/index.js",
    "vra": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "clean": "rm -rf dist/",
    "start": "node dist/cli/index.js",
    "start:dev": "tsx src/cli/index.ts"
  },
  "keywords": [
    "security",
    "vulnerability",
    "reachability",
    "cve",
    "analysis",
    "sca",
    "sbom"
  ],
  "author": "Lucas Verissimo <lucasvsantos591@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasvsantos591-hue/hawkeye.git"
  },
  "homepage": "https://github.com/lucasvsantos591-hue/hawkeye",
  "bugs": {
    "url": "https://github.com/lucasvsantos591-hue/hawkeye/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "axios": "^1.6.0",
    "docx": "^9.8.1",
    "js-yaml": "^5.4.2",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.0",
    "yargs": "^17.7.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@google/generative-ai": "^0.3.0",
    "openai": "^4.52.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    }
  }
}
